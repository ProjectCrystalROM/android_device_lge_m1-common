# CM13 core init imports /init.${ro.hardware}.rc; stock cmdline selects m1.
import /init.m1.fs.rc
import /init.m1.platform.rc
import /init.m1.usb.rc
import /init.m1.camera.rc

# Missing optional import is accepted by CM13 init; only wireless-enabled
# products install this focused fragment.
import /init.m1.wireless.rc

# Missing optional import is accepted by CM13 init; only the radio product installs it.
import /init.m1.radio.rc
