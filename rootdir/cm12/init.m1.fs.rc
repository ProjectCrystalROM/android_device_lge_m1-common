# Mount paths/options derived from the supplied MS33010m boot ramdisk and GPT.
# CM12.1 owns vold, encryption transitions, and emulated-storage services.
on init
    # Lollipop framework (including android.os.Debug during Zygote preload)
    # requires these exports; CM13's storage environment is not compatible.
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated
    export MEDIA_STORAGE /data/media
    export SECONDARY_STORAGE /storage/external_SD
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    mkdir /storage/emulated/legacy 0555 root root
    mkdir /storage/external_SD 0700 root root
    mkdir /mnt/media_rw/external_SD 0700 media_rw media_rw
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0
    mkdir /firmware 0771 system system
    mkdir /persist 0771 system system
    mkdir /persist-lg 0771 system system
    mkdir /sns 0771 system system
    mkdir /mpt 0775 system system

on fs
    mount_all /fstab.m1
    # Stock keeps auxiliary volumes outside mount_all: their failures must not
    # suppress fs_mgr's data/encryption startup result. These waits are bounded.
    wait /dev/block/bootdevice/by-name/persist 5
    mount ext4 /dev/block/bootdevice/by-name/persist /persist nosuid nodev noatime barrier=1,data=ordered,nodelalloc,errors=continue
    wait /dev/block/bootdevice/by-name/drm 5
    mount ext4 /dev/block/bootdevice/by-name/drm /persist-lg nosuid nodev noatime barrier=1,data=ordered,nodelalloc,errors=continue
    wait /dev/block/bootdevice/by-name/sns 5
    mount ext4 /dev/block/bootdevice/by-name/sns /sns nosuid nodev noatime barrier=1,data=ordered,nodelalloc,errors=continue
    wait /dev/block/bootdevice/by-name/mpt 5
    mount ext4 /dev/block/bootdevice/by-name/mpt /mpt nosuid nodev noatime barrier=1,noauto_da_alloc,errors=continue
    wait /dev/block/bootdevice/by-name/modem 5
    mount vfat /dev/block/bootdevice/by-name/modem /firmware ro context=u:object_r:firmware_file:s0,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337

on post-fs
    mkdir /persist/data 0700 system system
    restorecon_recursive /persist

on post-fs-data
    mkdir /data/media 0770 media_rw media_rw
    restorecon_recursive /data/media
    mkdir /data/time 0700 system system
    restorecon_recursive /data/time

# Lollipop uses the sdcard FUSE daemon; its storage contract differs from M.
service sdcard /system/bin/sdcard -u 1023 -g 1023 -l /data/media /mnt/shell/emulated
    class late_start
    oneshot

service fuse_external_SD /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/external_SD /storage/external_SD
    class late_start
    disabled
    oneshot

on property:init.svc.sdcard=running
    wait /mnt/shell/emulated/0 5
    mount none /mnt/shell/emulated/0 /storage/emulated/legacy bind
